<style>
  .sig {
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--ink);
  }
  .sig__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sig__name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 35px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .sig__it {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
  }
  .sig__role {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.3;
    color: var(--moss-deep);
    white-space: nowrap;
  }
  /* Mirrored leaf: scaleX(-1) flips it; the rotation is applied after the flip. */
  .sig__leaf {
    flex: none;
    width: 58px;
    height: 58px;
    fill: var(--moss);
    transform: scaleX(-1) rotate(-6deg);
  }
  .sig__leaf-bg {
    fill: var(--cream);
  }
  .sig:hover .sig__leaf {
    transform: scaleX(-1) rotate(-16deg);
    transition: transform 0.4s ease;
  }
  .sig:hover {
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .sig:hover .sig__leaf {
      transform: scaleX(-1) rotate(-6deg);
    }
  }

  @media (max-width: 860px) {
    .sig {
      gap: 10px;
    }
    .sig__name {
      font-size: 26px;
    }
    .sig__role {
      font-size: 12.5px;
    }
    .sig__leaf {
      width: 36px;
      height: 36px;
    }
  }
</style>
