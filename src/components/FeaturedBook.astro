---
// Bloc B — the new book: badge, title, buy buttons, cover in a cloud of floating bubbles.
import { Image } from 'astro:assets';
import BuyButtons from './BuyButtons.astro';
import { featured } from '../data/site';
---

<section id="ikigai" class="book" aria-labelledby="ikigai-title">
  <div class="container book__grid">
    <div class="book__head">
      <div class="book__tags">
        <span class="pill book__badge">Nouveau livre</span>
        <span class="book__release">{featured.releaseLabel}</span>
      </div>
      <h2 id="ikigai-title" class="book__title">{featured.title}</h2>
      <p class="book__subtitle">{featured.subtitle}</p>
    </div>

    <div class="book__visual">
      <span class="bubble bubble--1" aria-hidden="true"></span>
      <span class="bubble bubble--2" aria-hidden="true"></span>
      <span class="bubble bubble--3" aria-hidden="true"></span>
      <span class="bubble bubble--4" aria-hidden="true"></span>
      <span class="bubble bubble--5" aria-hidden="true"></span>
      <div class="book__cover">
        <Image
          src={featured.cover}
          alt={featured.coverAlt}
          widths={[184, 272, 368, 544]}
          sizes="(max-width: 860px) 184px, 272px"
          loading="eager"
        />
      </div>
    </div>

    <div class="book__buy">
      <p class="book__publisher">{featured.publisher}</p>
      <BuyButtons links={featured.buy} />
    </div>
  </div>
</section>

<style>
  .book {
    background: var(--moss-pale);
    border-top: var(--line);
  }
  /* Desktop: text column vertically centred beside the visual.
     Mobile: head → cover → buy buttons. */
  .book__grid {
    padding-top: 80px;
    padding-bottom: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-areas:
      '.    visual'
      'head visual'
      'buy  visual'
      '.    visual';
    column-gap: 56px;
  }
  .book__head {
    grid-area: head;
  }
  .book__visual {
    grid-area: visual;
  }
  .book__buy {
    grid-area: buy;
  }

  .book__tags {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .book__badge {
    background: var(--mustard);
    font-size: 12.5px;
    padding: 6px 14px;
  }
  .book__release {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 14px;
    color: var(--moss-deep);
  }
  .book__title {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 22px 0 0;
  }
  .book__subtitle {
    margin: 12px 0 0;
    font-style: italic;
    font-size: 24px;
    line-height: 1.3;
    color: var(--moss-deep);
    max-width: 22ch;
  }
  .book__publisher {
    margin: 18px 0 32px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 14.5px;
  }

  .book__visual {
    position: relative;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .book__cover {
    position: relative;
    width: 272px;
    height: 400px;
    border: var(--line);
    border-radius: 6px;
    box-shadow: 12px 12px 0 var(--ink);
    transform: rotate(-2deg);
    overflow: hidden;
    background: var(--cream);
  }
  .book__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Each bubble floats on its own period and phase so the cloud never moves in step. */
  .bubble {
    position: absolute;
    border-radius: 50%;
    animation: rise-float var(--dur) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .bubble--1 {
    width: 250px;
    height: 250px;
    background: var(--cream);
    top: 6px;
    right: 8px;
    --dur: 8s;
  }
  .bubble--2 {
    width: 132px;
    height: 132px;
    background: var(--mustard);
    bottom: 34px;
    right: 186px;
    --dur: 6.6s;
    --delay: -2.4s;
  }
  .bubble--3 {
    width: 96px;
    height: 96px;
    background: var(--rose);
    bottom: 2px;
    right: 14px;
    --dur: 9.4s;
    --delay: -5s;
  }
  .bubble--4 {
    width: 84px;
    height: 84px;
    border: 3px solid var(--moss);
    top: 52px;
    left: 6px;
    --dur: 7.4s;
    --delay: -1.1s;
  }
  .bubble--5 {
    width: 30px;
    height: 30px;
    background: var(--moss);
    top: 180px;
    left: 52px;
    --dur: 5.8s;
    --delay: -3.3s;
  }

  @keyframes rise-float {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(5px, -18px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .book__grid {
      padding-top: 36px;
      padding-bottom: 40px;
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas:
        'head'
        'visual'
        'buy';
    }
    .book__tags {
      gap: 10px;
    }
    .book__badge {
      font-size: 11.5px;
      padding: 5px 12px;
    }
    .book__release {
      font-size: 13px;
    }
    .book__title {
      font-size: 46px;
      letter-spacing: -0.025em;
      margin-top: 16px;
    }
    .book__subtitle {
      margin-top: 8px;
      font-size: 19px;
      max-width: none;
    }
    .book__visual {
      height: 290px;
      margin-top: 24px;
    }
    .book__cover {
      width: 184px;
      height: 268px;
      box-shadow: 9px 9px 0 var(--ink);
    }
    .book__publisher {
      margin: 22px 0 14px;
      font-size: 13.5px;
    }
    .bubble--1 {
      width: 170px;
      height: 170px;
      top: 0;
      right: 4px;
    }
    .bubble--2 {
      width: 76px;
      height: 76px;
      bottom: 16px;
      right: 112px;
    }
    .bubble--4 {
      width: 58px;
      height: 58px;
      top: 34px;
      left: 2px;
    }
    .bubble--3,
    .bubble--5 {
      display: none;
    }
  }
</style>
