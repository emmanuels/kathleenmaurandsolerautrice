---
// Bloc A — the author: bio on the left, headline in a cloud of floating bubbles on the right.
// The h1 stays first in the DOM (and first on mobile); the grid moves it right on desktop.
import { site } from '../data/site';
---

<section id="autrice" class="autrice" aria-labelledby="autrice-title">
  <div class="container autrice__grid">
    <div class="autrice__visual">
      <span class="bubble bubble--1" aria-hidden="true"></span>
      <span class="bubble bubble--2" aria-hidden="true"></span>
      <span class="bubble bubble--3" aria-hidden="true"></span>
      <span class="bubble bubble--4" aria-hidden="true"></span>
      <span class="bubble bubble--5" aria-hidden="true"></span>
      <h1 id="autrice-title" class="autrice__title">Des mots<br class="only-desktop" /> qui font<br class="only-desktop" /> <span class="it">grandir.</span></h1>
    </div>
    <div class="autrice__bio">
      {site.bio.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<style>
  .autrice {
    background: var(--cream);
  }
  .autrice__grid {
    padding-top: 88px;
    padding-bottom: 92px;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 72px;
    align-items: center;
  }
  .autrice__bio {
    grid-column: 1;
    grid-row: 1;
    border-right: 2px dashed var(--rule);
    padding-right: 48px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .autrice__bio p {
    margin: 0;
    font-size: 17px;
    /* Justified with French hyphenation (html lang="fr") to avoid wide gaps. */
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    hyphenate-limit-chars: 7 3 3;
  }

  .autrice__visual {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    min-height: 340px;
    display: flex;
    align-items: center;
    /* Title pushed right, into the big pale bubble. */
    justify-content: flex-end;
    padding-right: 72px;
  }
  .autrice__title {
    position: relative;
    z-index: 1;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 76px;
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin: 0;
    /* Explicit line breaks on desktop so the box hugs the text and can sit right. */
    white-space: nowrap;
  }

  /* Same floating bubbles as the Ikigaï block, each on its own period and phase. */
  .bubble {
    position: absolute;
    border-radius: 50%;
    animation: autrice-float var(--dur) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .bubble--1 {
    width: 250px;
    height: 250px;
    background: var(--moss-pale);
    top: 0;
    right: 0;
    --dur: 8s;
  }
  .bubble--2 {
    width: 110px;
    height: 110px;
    background: var(--mustard);
    bottom: -34px;
    left: 0;
    --dur: 6.6s;
    --delay: -2.4s;
  }
  .bubble--3 {
    width: 80px;
    height: 80px;
    background: var(--rose);
    bottom: -26px;
    right: 24px;
    --dur: 9.4s;
    --delay: -5s;
  }
  .bubble--4 {
    width: 76px;
    height: 76px;
    border: 3px solid var(--moss);
    top: -18px;
    left: -6px;
    --dur: 7.4s;
    --delay: -1.1s;
  }
  .bubble--5 {
    width: 26px;
    height: 26px;
    background: var(--moss);
    top: 200px;
    left: -22px;
    --dur: 5.8s;
    --delay: -3.3s;
  }

  @keyframes autrice-float {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(5px, -18px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .autrice__grid {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-top: 28px;
      padding-bottom: 40px;
    }
    .autrice__visual,
    .autrice__bio {
      grid-column: 1;
      grid-row: auto;
    }
    .autrice__visual {
      min-height: 230px;
      justify-content: center;
      padding-right: 0;
    }
    .autrice__title {
      font-size: 46px;
      line-height: 0.98;
      white-space: normal;
      max-width: 9ch;
      text-wrap: balance;
    }
    .autrice__bio {
      border-right: 0;
      border-top: 2px dashed var(--rule);
      padding-right: 0;
      padding-top: 24px;
      gap: 14px;
    }
    .autrice__bio p {
      font-size: 16px;
    }
    .bubble--1 {
      width: 170px;
      height: 170px;
      right: 10px;
    }
    .bubble--2 {
      width: 70px;
      height: 70px;
      bottom: 0;
      left: 16px;
    }
    .bubble--3 {
      width: 52px;
      height: 52px;
      bottom: 10px;
      right: 20px;
    }
    .bubble--4 {
      width: 52px;
      height: 52px;
      top: 8px;
      left: 10px;
    }
    .bubble--5 {
      display: none;
    }
  }
</style>
