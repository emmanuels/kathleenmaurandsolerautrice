---
// Bloc A — the author: headline on the left, portrait thumbnail + 120-word bio on the right.
import { Image } from 'astro:assets';
import portrait from '../assets/photos/kathleen-maurand-soler.webp';
import { site } from '../data/site';
---

<section id="autrice" class="autrice" aria-labelledby="autrice-title">
  <div class="container autrice__grid">
    <h1 id="autrice-title" class="autrice__title">Des mots qui font <span class="it">grandir.</span></h1>
    <div class="autrice__bio">
      <div class="autrice__id">
        <div class="autrice__photo">
          <span class="autrice__bubble" aria-hidden="true"></span>
          <div class="autrice__frame">
            <Image
              src={portrait}
              alt="Portrait de Kathleen Maurand Soler, souriante, devant un olivier"
              widths={[96, 120, 192, 240]}
              sizes="(max-width: 860px) 96px, 120px"
              loading="eager"
            />
          </div>
        </div>
        <div>
          <p class="autrice__name">Kathleen <span class="it">Maurand Soler</span></p>
          <p class="autrice__role">Autrice · transmission &amp; quête de sens</p>
        </div>
      </div>
      {site.bio.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<style>
  .autrice {
    background: var(--cream);
  }
  .autrice__grid {
    padding-top: 88px;
    padding-bottom: 92px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 72px;
    align-items: center;
  }
  .autrice__title {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 76px;
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 12ch;
    text-wrap: balance;
  }
  .autrice__bio {
    border-left: 2px dashed var(--rule);
    padding-left: 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .autrice__bio p {
    margin: 0;
    font-size: 17px;
    /* Justified with French hyphenation (html lang="fr") to avoid wide gaps. */
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    hyphenate-limit-chars: 7 3 3;
  }

  /* Round portrait echoing the bubbles, with the site's hard ink shadow. */
  .autrice__id {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 8px;
  }
  .autrice__photo {
    position: relative;
    flex: none;
    width: 120px;
    height: 120px;
  }
  .autrice__frame {
    position: relative;
    width: 100%;
    height: 100%;
    border: var(--line);
    border-radius: 50%;
    box-shadow: 6px 6px 0 var(--ink);
    overflow: hidden;
  }
  /* Translucent moss veil to tie the photo to the palette. */
  .autrice__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--moss);
    opacity: 0.28;
  }
  .autrice__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .autrice__bubble {
    position: absolute;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--rose);
    top: -6px;
    right: -10px;
    z-index: 1;
  }
  .autrice__bio .autrice__name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
  }
  .autrice__name .it {
    font-weight: 500;
  }
  .autrice__bio .autrice__name,
  .autrice__bio .autrice__role {
    text-align: left;
  }
  .autrice__bio .autrice__role {
    margin-top: 4px;
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .autrice__grid {
      grid-template-columns: 1fr;
      gap: 26px;
      padding-top: 36px;
      padding-bottom: 40px;
    }
    .autrice__title {
      font-size: 46px;
      line-height: 0.98;
      max-width: none;
    }
    .autrice__bio {
      border-left: 0;
      border-top: 2px dashed var(--rule);
      padding-left: 0;
      padding-top: 24px;
      gap: 14px;
    }
    .autrice__bio p {
      font-size: 16px;
    }
    .autrice__id {
      gap: 18px;
      margin-bottom: 6px;
    }
    .autrice__photo {
      width: 96px;
      height: 96px;
    }
    .autrice__frame {
      box-shadow: 5px 5px 0 var(--ink);
    }
    .autrice__bubble {
      width: 26px;
      height: 26px;
    }
    .autrice__bio .autrice__name {
      font-size: 16.5px;
    }
    .autrice__bio .autrice__role {
      font-size: 13px;
    }
  }
</style>
